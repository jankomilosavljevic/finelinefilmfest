# Admin: ne indeksirati, PHP ulaz
DirectoryIndex index.php
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Pomoćni PHP fajlovi se ne otvaraju direktno
<FilesMatch "^(lib\.php|set-password\.php|\.user\.ini)$">
    Require all denied
</FilesMatch>
